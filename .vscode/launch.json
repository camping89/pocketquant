{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (app.main)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "pocketquant.app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port",
        "41921"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "osx": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "linux": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "osx": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "linux": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    }
  ]
}
