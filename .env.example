# PocketQuant Configuration
# Copy to .env: cp .env.example .env

# ─── Application ──────────────────────────────────────────────
APP_NAME=PocketQuant
APP_VERSION=0.1.0
ENVIRONMENT=development

# MongoDB
MONGO_PORT=52017
MONGODB_URL=mongodb://pocketquant:pocketquant_dev@localhost:52017/pocketquant?authSource=admin
MONGODB_DATABASE=pocketquant
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Redis
REDIS_PORT=53679
REDIS_URL=redis://localhost:53679/0
REDIS_CACHE_TTL=3600

# Logging: DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_LEVEL=INFO
# Logging format: json (production) | console (development)
LOG_FORMAT=console

# Background Jobs
ENABLE_JOBS=true

# OKX Broker (optional, for live trading)
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
OKX_DEMO_MODE=true

# Strategy Engine
DEFAULT_BROKER=paper
PAPER_INITIAL_BALANCE=100000
PAPER_SLIPPAGE_PERCENT=0.001

# ─── Production Infrastructure ────────────────────────────────
# See docs/deployment-guide.md for setup instructions.
# DOCKERHUB_USERNAME=your-dockerhub-username
# IMAGE_TAG=latest
# MONGO_USER=pocketquant
# MONGO_PASSWORD=change_this_strong_password
WEB_PORT=80
APP_PORT=58921
MONGO_PORT=52017
REDIS_PORT=53679
PORTAINER_PORT=54900
