# PocketQuant — App config for local run AND VPS deploy
#
# Copy to .env and fill in:
#   cp .env.example .env
#
# Layout: 2 sections — APP, PROD.
#   • APP  — runtime config read by the FastAPI app (local + VPS).
#   • PROD — Docker/compose values consumed only when deploying to the VPS.
#
# The wrapper deploy/deploy.sh scp's THIS file to the VPS as
# /opt/pocketquant/deploy/.env, so it must hold every var that the prod
# stack needs at runtime.
#
# For OPERATOR-side infra config (VPS_HOST, SSH key, CI gating), see
# deploy/vps/.env.example — that file lives on your laptop only.
#
# Pydantic uses extra="ignore" so PROD vars don't break local runs.

# ╔════════════════════════════════════════════════════════════╗
# ║ APP                                                        ║
# ╚════════════════════════════════════════════════════════════╝

APP_NAME=PocketQuant
APP_VERSION=0.1.0
ENVIRONMENT=development          # production | development
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # json (production) | console (development)

# MongoDB — for local-dev-pointing-at-prod, set host to the VPS IP.
MONGO_PORT=52017
MONGODB_URL=mongodb://pocketquant:pocketquant_dev@localhost:52017/pocketquant?authSource=admin
MONGODB_DATABASE=pocketquant
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Redis
REDIS_PORT=53679
REDIS_URL=redis://localhost:53679/0
REDIS_CACHE_TTL=3600

# Background Jobs
ENABLE_JOBS=true

# Strategy Engine
DEFAULT_BROKER=paper             # paper | okx
PAPER_INITIAL_BALANCE=100000
PAPER_SLIPPAGE_PERCENT=0.001

# OKX Broker (optional, only if DEFAULT_BROKER=okx or for live trading)
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
OKX_DEMO_MODE=true

# ╔════════════════════════════════════════════════════════════╗
# ║ PROD                                                       ║
# ║ Docker / container ports — required on the VPS.            ║
# ║ Local runs ignore these (Pydantic extra="ignore").         ║
# ╚════════════════════════════════════════════════════════════╝

# Docker Hub source for prod images
# DOCKERHUB_USERNAME=your-dockerhub-username
# IMAGE_TAG=latest

# Mongo root user/password — used by the Mongo container at first boot
# AND embedded in MONGODB_URL above. Keep both in sync.
# MONGO_USER=pocketquant
# MONGO_PASSWORD=change_this_strong_password

# Container ports
WEB_PORT=80                      # PUBLIC SPA + /api reverse proxy. Use 443 for direct TLS.
APP_PORT=58921                   # Obscure — not directly public
MONGO_PORT=52017                 # Obscure
REDIS_PORT=53679                 # Obscure
PORTAINER_PORT=54900             # Obscure
