   "motor>=3.3.0",           # Async MongoDB driver
   "pymongo>=4.6.0",

   # AFTER
   "pymongo>=4.16.0",        # Async MongoDB driver (native async API)
   ```

2. **Reinstall dependencies**
   ```bash
