        self._running = True

        while self._running:
            try:
                if self._ws is None:
                    await self.connect()

                    # Atomically snapshot subscriptions under lock
                    async with self._subscription_lock:
                        symbols_to_resubscribe = list(self._subscriptions.keys())

                    for symbol_key in symbols_to_resubscribe:
