# HTTPS mode - use when you have a domain
# Rename to Caddyfile and set DOMAIN environment variable

{$DOMAIN:api.example.com} {
    # Automatic HTTPS via Let's Encrypt

    # API - Main application
    handle /api/* {
        reverse_proxy app:41920
    }

    handle /health {
        reverse_proxy app:41920
    }

    # OpenAPI docs
    handle /api/v1/docs* {
        reverse_proxy app:41920
    }
    handle /api/v1/redoc* {
        reverse_proxy app:41920
    }
    handle /api/v1/openapi.json {
        reverse_proxy app:41920
    }

    # Portainer - protected
    handle /portainer/* {
        # Basic auth protection (generate hash with: caddy hash-password)
        basicauth {
            admin $PORTAINER_HASH
        }
        uri strip_prefix /portainer
        reverse_proxy portainer:9000
    }

    # Grafana
    handle /grafana/* {
        uri strip_prefix /grafana
        reverse_proxy grafana:3000
    }

    # Mongo Express - protected
    handle /mongo/* {
        basicauth {
            admin $MONGO_EXPRESS_HASH
        }
        uri strip_prefix /mongo
        reverse_proxy mongo-express:8081
    }

    handle {
        redir /api/v1/docs permanent
    }

    log {
        output stdout
        format json
        level INFO
    }
}
